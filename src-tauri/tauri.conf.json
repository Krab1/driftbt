{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drift",
  "version": "0.0.1",
  "identifier": "app.drift.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "create": false, "title": "Drift", "decorations": false, "shadow": true, "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu", "width": 1100, "height": 700, "minWidth": 900, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Drift",
    "shortDescription": "A fast, light BitTorrent client",
    "category": "Utility",
    "fileAssociations": [
      { "ext": ["torrent"], "name": "BitTorrent file", "description": "BitTorrent file", "mimeType": "application/x-bittorrent", "role": "Viewer" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh", "displayLanguageSelector": false }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
